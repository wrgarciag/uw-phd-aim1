# ============================================================
# 03_ppd_estimation_trends_state.R   (FIXED)
# Purpose: Estimate probability of premature death (PPD = 70q0)
#          and trends by U.S. state, sex, year.
#
# Fix notes (vs. previous version):
#   The input mortality table is an ABRIDGED life table with age
#   groups of unequal width:
#       age 0   -> width 1   (Under 1)
#       age 1   -> width 1   (1)
#       age 2   -> width 3   (2-4)
#       age 5   -> width 5   (5-9)
#       age 10  -> width 5   (10-14)
#       ...
#       age 65  -> width 5   (65-69)
#
#   The previous code (a) collapsed ages 1 and 2 into one row
#   (mixing a 1-year group with a 3-year group), (b) applied the
#   1-year qx formula  qx = mx / (1 + (1-ax)*mx)  to every row,
#   and (c) multiplied (1 - qx) across only ~16 rows -- effectively
#   computing survival over ~16 person-years instead of 70.
#   That is why PPD came out ~4x too low (e.g. WA male 2019 -> 5%
#   instead of the GBD value ~23%).
#
#   Correct abridged life-table formula:
#       qx_n = n * mx / (1 + (n - ax) * mx)
#   with n = width of the interval and ax = mean person-years lived
#   in the interval by those who die. We use:
#       ax = 0.1  for age 0  (infant deaths concentrated early)
#       ax = n/2  for all other intervals
# ============================================================
age_cutoff   <- 70
baseline_year <- 2023        # set this to 2019 if you want a
# pre-pandemic baseline like the paper
target_year  <- 2050
years_keep   <- 1990:2023
dt_mx <- readRDS(paste0(wd_data, "state_age_sex_mortality_gbd.rds"))
# Keep only ages strictly below the cutoff and the years of interest
dt_mx <- dt_mx[
year %in% years_keep &
age  >= 0 &
age  <  age_cutoff
]
# -------- assign the width of each age interval (in years) --------
# 0 -> 1, 1 -> 1, 2 -> 3 (2-4), 5/10/.../65 -> 5
dt_mx[, n := fcase(
age == 0L, 1L,
age == 1L, 1L,
age == 2L, 3L,
default  = 5L
)]
# -------- ax: mean person-years lived in interval by decedents ---
# Infants: deaths concentrated in first weeks -> ax ~ 0.1
# All other groups: midpoint approximation -> ax = n/2
dt_mx[, ax := fifelse(age == 0L, 0.1, n / 2)]
# -------- abridged-life-table conditional probability of death ---
dt_mx[, qx := (n * mx) / (1 + (n - ax) * mx)]
dt_mx[, qx := pmin(pmax(qx, 0), 1)]
dt_mx[, px := 1 - qx]
# -------- PPD = 1 - product of survival probs over all intervals -
# (Sorting by age is not strictly required for prod(), but keeps
# any debugging output sensible.)
setorder(dt_mx, state, year, sex, age)
dt_ppd <- dt_mx[
,
.(
l0   = 100000,
l70  = 100000 * prod(px),
ppd  = 1 - prod(px)
),
by = .(state, year, sex)
]
dt_ppd[, ppd_pct := 100 * ppd]
# ============================================================
# Average annual rate of improvement (AARI) and 50-by-50 progress
# ============================================================
compute_aari <- function(q_start, q_end, n_years) {
(q_start / q_end)^(1 / n_years) - 1
}
dt_wide <- dcast(
dt_ppd,
state + sex ~ year,
value.var = "ppd"
)
periods <- list(
c(1990, 2019),
c(2000, 2010),
c(2010, 2019),
c(2019, 2023)
)
dt_aari <- rbindlist(lapply(periods, function(p) {
y0 <- as.character(p[1])
y1 <- as.character(p[2])
if (!all(c(y0, y1) %in% names(dt_wide))) return(NULL)
tmp <- copy(dt_wide)
tmp[, `:=`(
year_start = p[1],
year_end   = p[2],
ppd_start  = get(y0),
ppd_end    = get(y1),
n_years    = p[2] - p[1]
)]
tmp[, aari := compute_aari(ppd_start, ppd_end, n_years)]
tmp[, .(state, sex, year_start, year_end, ppd_start, ppd_end, aari)]
}))
dt_target <- dt_ppd[
year == baseline_year,
.(state, sex, ppd_baseline = ppd)
]
dt_target[, ppd_2050_target := 0.5 * ppd_baseline]
dt_target[, required_aari :=
compute_aari(ppd_baseline, ppd_2050_target,
target_year - baseline_year)]
dt_recent <- dt_aari[
year_start == 2010 & year_end == 2019,
.(state, sex, observed_aari_2010_2019 = aari)
]
dt_progress <- merge(
dt_target,
dt_recent,
by = c("state", "sex"),
all.x = TRUE
)
View(dt_progress)
dt_progress[, performance_group := fifelse(
observed_aari_2010_2019 >= required_aari, "On track",
fifelse(observed_aari_2010_2019 >= 0.01, "Medium progress",
"Low or worsening")
)]
dt_progress[, implied_ppd_2050 :=
ppd_baseline /
((1 + observed_aari_2010_2019)^(target_year - baseline_year))]
dt_progress[, implied_reduction_2050 :=
1 - implied_ppd_2050 / ppd_baseline]
View(dt_progress)
fwrite(dt_ppd,      paste0(wd_outp, "ppd_state_year_sex.csv"))
fwrite(dt_aari,     paste0(wd_outp, "ppd_aari_state_sex.csv"))
fwrite(dt_progress, paste0(wd_outp, "ppd_50by50_progress_state_sex.csv"))
