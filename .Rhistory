read_gbd_folder <- function(path, cluster_name) {
files <- list.files(
path,
pattern = "\\.csv$",
full.names = TRUE
)
stopifnot(length(files) > 0)
dt_list <- lapply(files, function(f) {
x <- fread(f)
x[, source_file := basename(f)]
x[, cluster := cluster_name]
x
})
rbindlist(dt_list, use.names = TRUE, fill = TRUE)
}
