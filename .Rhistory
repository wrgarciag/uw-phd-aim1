# Load cases classification to group causes
# File/ columns structure is the same as all causes
dt_cause_mapping <- read_excel(
path       = paste0(wd_data, "Karlsson2025_GBD_US_mapping_final.xlsx"),
sheet      = "User_GBD_causes",
col_names  = TRUE
) %>%
as.data.table()
View(dt_cause_mort)
gbd_causes <- unique(dt_cause_mort$cause_name)
mapping_causes <- unique(dt_cause_mapping$cause_name)
mapping_causes
missing_mappings <- setdiff(gbd_causes, mapping_causes)
missing_mappings
mapping_causes <- unique(dt_cause_mapping$gbd_cause_name)
missing_mappings <- setdiff(gbd_causes, mapping_causes)
missing_mappings
missing_mappings
# Check that all cause names in the GBD data have a mapping
gbd_causes <- unique(dt_cause_mort$cause_name)
mapping_causes <- unique(dt_cause_mapping$gbd_cause_name)
gbd_causes
missing_mappings <- setdiff(gbd_causes, mapping_causes)
missing_mappings
dt_cause_mort <- merge(dt_cause_mort, dt_cause_mapping,
by.x = "cause_name", by.y = "GBD_cause_used", all.x = TRUE)
# Merge cause-specific mortality with mapping to get cause groups
dt_cause_mort <- merge(dt_cause_mort, dt_cause_mapping[, .(GBD_cause_used, Classification)],
by.x = "cause_name", by.y = "GBD_cause_used", all.x = TRUE)
table(dt_cause_mort$Classification, useNA = "ifany")  # check mapping
table(dt_cause_mort$Classification)  # check mapping
View(dt_cause_mapping)
View(dt_cause_mort)
rm(list=ls())
