% olg_model_scenario.m
% Overlapping Generations (OLG) Model with CRRA Utility and Exogenous Growth in MATLAB
% Simulates a linear reduction in young mortality probability from 0.2 in 2025 to 0.1 in 2050
% Computes discounted present value (2025) of differences between base (mu=0.2) and reduction scenarios
% Uses efficiency units to account for exogenous technological growth
% Save this file as 'olg_model_scenario.m' and run with: run olg_model_scenario or olg_model_scenario
% Can be called from a wrapper script like run_us_olg_mortality.m

clear all;
close all;

% Parameters
alpha = 0.33;     % Capital share
beta = 0.95;      % Discount factor
n = 0.01;         % Population growth rate
delta = 0.05;     % Depreciation rate
theta = 2.0;      % CRRA coefficient
g = 0.02;         % Exogenous technological growth rate
mu_initial = 0.2; % Initial mortality probability (2025)
mu_final = 0.1;   % Final mortality probability (2050)
T_reduction = 25; % Years for linear reduction (2025 to 2050)
T = 100;          % Number of periods

% Linear reduction slope
slope = (mu_initial - mu_final) / T_reduction; % 0.004 per year

% Mortality probability functions
mu_base_t = @(t) mu_initial; % Base scenario: constant mu
mu_reduction_t = @(t) max(mu_final, mu_initial - slope * t); % Reduction scenario

% Production function (per worker, efficiency units)
production = @(k_tilde) k_tilde.^alpha;

% Wage (efficiency units)
wage = @(k_tilde) (1 - alpha) * production(k_tilde);

% Interest rate
interest_rate = @(k_tilde) alpha * k_tilde.^(alpha - 1) - delta;

% Psi function (element-wise for vectors)
psi = @(mu, r) ((1 - mu) .* beta .* (1 + r).^(2 - theta)).^(1/theta);

% Savings function (efficiency units)
savings = @(w_tilde, mu, r) (psi(mu, r) .* w_tilde) ./ (1 + psi(mu, r));

% Capital dynamics (efficiency units)
capital_dynamics = @(k_tilde, mu) savings(wage(k_tilde), mu, interest_rate(k_tilde)) / ((1 + n) * (1 + g));

% Steady-state equation for k_tilde
steady_state_eq = @(k_tilde, mu) k_tilde - capital_dynamics(k_tilde, mu);

% Solve for steady state
find_steady_state = @(mu) fsolve(@(k_tilde) steady_state_eq(k_tilde, mu), 1.0, optimoptions('fsolve', 'Display', 'off'));

% Compute initial and final steady states (efficiency units)
k_tilde_star_initial = find_steady_state(mu_initial);
k_tilde_star_final = find_steady_state(mu_final);

% Compute steady-state variables (efficiency units)
compute_vars = @(k_tilde, mu) deal(...
    k_tilde, ... % k_tilde
    production(k_tilde), ... % y_tilde
    wage(k_tilde), ... % w_tilde
    interest_rate(k_tilde), ... % r
    psi(mu, interest_rate(k_tilde)), ... % psi
    wage(k_tilde) ./ (1 + psi(mu, interest_rate(k_tilde))), ... % c_y_tilde
    savings(wage(k_tilde), mu, interest_rate(k_tilde)), ... % s_tilde
    (1 + interest_rate(k_tilde)) * savings(wage(k_tilde), mu, interest_rate(k_tilde))); % c_o_tilde

[k_tilde_initial, y_tilde_initial, w_tilde_initial, r_initial, psi_initial, c_y_tilde_initial, s_tilde_initial, c_o_tilde_initial] = compute_vars(k_tilde_star_initial, mu_initial);
[k_tilde_final, y_tilde_final, w_tilde_final, r_final, psi_final, c_y_tilde_final, s_tilde_final, c_o_tilde_final] = compute_vars(k_tilde_star_final, mu_final);

% Simulate base scenario (mu = 0.2 constant, efficiency units)
k_tilde_base = zeros(T+1, 1);
mu_base = zeros(T+1, 1);
k_tilde_base(1) = k_tilde_star_initial;
mu_base(1) = mu_initial;

for t = 1:T
    mu_base(t+1) = mu_base_t(t);
    k_tilde_base(t+1) = capital_dynamics(k_tilde_base(t), mu_base(t+1));
end

y_tilde_base = production(k_tilde_base);
w_tilde_base = wage(k_tilde_base);
r_base = interest_rate(k_tilde_base);
psi_base = psi(mu_base, r_base);
c_y_tilde_base = w_tilde_base ./ (1 + psi_base);
s_tilde_base = w_tilde_base - c_y_tilde_base;
c_o_tilde_base = (1 + r_base) .* [s_tilde_initial; s_tilde_base(1:end-1)];

% Simulate reduction scenario (mu = 0.2 to 0.1, efficiency units)
k_tilde_reduction = zeros(T+1, 1);
mu_reduction = zeros(T+1, 1);
k_tilde_reduction(1) = k_tilde_star_initial;
mu_reduction(1) = mu_initial;

for t = 1:T
    mu_reduction(t+1) = mu_reduction_t(t);
    k_tilde_reduction(t+1) = capital_dynamics(k_tilde_reduction(t), mu_reduction(t+1));
end

y_tilde_reduction = production(k_tilde_reduction);
w_tilde_reduction = wage(k_tilde_reduction);
r_reduction = interest_rate(k_tilde_reduction);
psi_reduction = psi(mu_reduction, r_reduction);
c_y_tilde_reduction = w_tilde_reduction ./ (1 + psi_reduction);
s_tilde_reduction = w_tilde_reduction - c_y_tilde_reduction;
c_o_tilde_reduction = (1 + r_reduction) .* [s_tilde_initial; s_tilde_reduction(1:end-1)];

% Compute differences (efficiency units)
delta_k_tilde = k_tilde_reduction - k_tilde_base;
delta_y_tilde = y_tilde_reduction - y_tilde_base;
delta_w_tilde = w_tilde_reduction - w_tilde_base;
delta_r = r_reduction - r_base;
delta_c_y_tilde = c_y_tilde_reduction - c_y_tilde_base;
delta_c_o_tilde = c_o_tilde_reduction - c_o_tilde_base;

% Total consumption (efficiency units)
c_total_tilde_base = c_y_tilde_base + c_o_tilde_base;
c_total_tilde_reduction = c_y_tilde_reduction + c_o_tilde_reduction;
delta_c_total_tilde = c_total_tilde_reduction - c_total_tilde_base;

% Compute DPV (use base scenario steady-state interest rate)
r_discount = r_initial;
discount_factor = 1 / (1 + r_discount);
dpv = @(delta) sum(delta .* (discount_factor .^ (0:T)));

dpv_k_tilde = dpv(delta_k_tilde);
dpv_y_tilde = dpv(delta_y_tilde);
dpv_w_tilde = dpv(delta_w_tilde);
dpv_r = dpv(delta_r);
dpv_c_y_tilde = dpv(delta_c_y_tilde);
dpv_c_o_tilde = dpv(delta_c_o_tilde);
dpv_c_total_tilde = dpv(delta_c_total_tilde);

% Display DPV results
disp('Discounted Present Value (2025) of Differences (Reduction - Base, Efficiency Units):');
fprintf('Capital (k_tilde): %.4f\n', dpv_k_tilde);
fprintf('Output (y_tilde): %.4f\n', dpv_y_tilde);
fprintf('Wage (w_tilde): %.4f\n', dpv_w_tilde);
fprintf('Interest rate (r): %.4f\n', dpv_r);
fprintf('Young consumption (c_y_tilde): %.4f\n', dpv_c_y_tilde);
fprintf('Old consumption (c_o_tilde): %.4f\n', dpv_c_o_tilde);
fprintf('Total consumption (c_y_tilde + c_o_tilde): %.4f\n', dpv_c_total_tilde);

% Plot differences (efficiency units)
figure('Position', [100, 100, 1200, 1000]);

% Capital difference
subplot(3, 2, 1);
plot(2025:2025+T, delta_k_tilde, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [0 0], 'k--', 'LineWidth', 1);
xlabel('Year');
ylabel('\Delta k_tilde_t');
title('Difference in Capital (Reduction - Base)');
grid on;

% Output difference
subplot(3, 2, 2);
plot(2025:2025+T, delta_y_tilde, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [0 0], 'k--', 'LineWidth', 1);
xlabel('Year');
ylabel('\Delta y_tilde_t');
title('Difference in Output (Reduction - Base)');
grid on;

% Young consumption difference
subplot(3, 2, 3);
plot(2025:2025+T, delta_c_y_tilde, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [0 0], 'k--', 'LineWidth', 1);
xlabel('Year');
ylabel('\Delta c_y_tilde_t');
title('Difference in Young Consumption');
grid on;

% Old consumption difference
subplot(3, 2, 4);
plot(2025:2025+T, delta_c_o_tilde, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [0 0], 'k--', 'LineWidth', 1);
xlabel('Year');
ylabel('\Delta c_o_tilde_t');
title('Difference in Old Consumption');
grid on;

% Total consumption difference
subplot(3, 2, 5);
plot(2025:2025+T, delta_c_total_tilde, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [0 0], 'k--', 'LineWidth', 1);
xlabel('Year');
ylabel('\Delta c_total_tilde_t');
title('Difference in Total Consumption');
grid on;

% Save figure with error handling
try
    saveas(gcf, 'olg_differences_dpv_growth.png');
catch e
    warning('Failed to save figure: %s', e.message);
end

% Save results with error handling
try
    save('olg_dpv_results_growth.mat', ...
        'k_tilde_base', 'y_tilde_base', 'w_tilde_base', 'r_base', 'c_y_tilde_base', 'c_o_tilde_base', 'c_total_tilde_base', ...
        'k_tilde_reduction', 'y_tilde_reduction', 'w_tilde_reduction', 'r_reduction', 'c_y_tilde_reduction', 'c_o_tilde_reduction', 'c_total_tilde_reduction', ...
        'mu_base', 'mu_reduction', 'delta_k_tilde', 'delta_y_tilde', 'delta_w_tilde', 'delta_r', 'delta_c_y_tilde', 'delta_c_o_tilde', 'delta_c_total_tilde', ...
        'dpv_k_tilde', 'dpv_y_tilde', 'dpv_w_tilde', 'dpv_r', 'dpv_c_y_tilde', 'dpv_c_o_tilde', 'dpv_c_total_tilde', ...
        'k_tilde_star_initial', 'k_tilde_star_final', 'y_tilde_initial', 'y_tilde_final');
catch e
    warning('Failed to save results: %s', e.message);
end

% Plot reduction scenario paths (efficiency units, for reference)
figure('Position', [100, 100, 1200, 1000]);

% Capital
subplot(3, 2, 1);
plot(2025:2025+T, k_tilde_reduction, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [k_tilde_star_initial k_tilde_star_initial], 'r--', 'LineWidth', 1.5);
plot([2025 2025+T], [k_tilde_star_final k_tilde_star_final], 'g--', 'LineWidth', 1.5);
xlabel('Year');
ylabel('Capital per worker (k_tilde_t)');
title('Capital Transition (Reduction Scenario)');
legend('k_tilde_t', 'Initial Steady State', 'Final Steady State', 'Location', 'best');
grid on;

% Output
subplot(3, 2, 2);
plot(2025:2025+T, y_tilde_reduction, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [y_tilde_initial y_tilde_initial], 'r--', 'LineWidth', 1.5);
plot([2025 2025+T], [y_tilde_final y_tilde_final], 'g--', 'LineWidth', 1.5);
xlabel('Year');
ylabel('Output per worker (y_tilde_t)');
title('Output Transition (Reduction Scenario)');
legend('y_tilde_t', 'Initial Steady State', 'Final Steady State', 'Location', 'best');
grid on;

% Young consumption
subplot(3, 2, 3);
plot(2025:2025+T, c_y_tilde_reduction, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [c_y_tilde_initial c_y_tilde_initial], 'r--', 'LineWidth', 1.5);
plot([2025 2025+T], [c_y_tilde_final c_y_tilde_final], 'g--', 'LineWidth', 1.5);
xlabel('Year');
ylabel('Young consumption (c_y_tilde_t)');
title('Young Consumption Transition');
legend('c_y_tilde_t', 'Initial Steady State', 'Final Steady State', 'Location', 'best');
grid on;

% Old consumption
subplot(3, 2, 4);
plot(2025:2025+T, c_o_tilde_reduction, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [c_o_tilde_initial c_o_tilde_initial], 'r--', 'LineWidth', 1.5);
plot([2025 2025+T], [c_o_tilde_final c_o_tilde_final], 'g--', 'LineWidth', 1.5);
xlabel('Year');
ylabel('Old consumption (c_o_tilde_t)');
title('Old Consumption Transition');
legend('c_o_tilde_t', 'Initial Steady State', 'Final Steady State', 'Location', 'best');
grid on;

% Mortality probability
subplot(3, 2, 5);
plot(2025:2025+T, mu_reduction, 'b-', 'LineWidth', 2);
hold on;
plot([2025 2025+T], [mu_initial mu_initial], 'r--', 'LineWidth', 1.5);
plot([2025 2025+T], [mu_final mu_final], 'g--', 'LineWidth', 1.5);
xlabel('Year');
ylabel('Mortality probability (\mu_t)');
title('Mortality Probability Transition');
legend('\mu_t', 'Initial \mu', 'Final \mu', 'Location', 'best');
grid on;

% Save figure with error handling
try
    saveas(gcf, 'olg_transition_progressive_growth.png');
catch e
    warning('Failed to save figure: %s', e.message);
end

% Display steady-state results
disp('Steady State Results (Efficiency Units):');
disp(['Initial k_tilde* (mu = 0.2, 2025): ', num2str(k_tilde_star_initial)]);
disp(['Final k_tilde* (mu = 0.1, 2050+): ', num2str(k_tilde_star_final)]);
disp(['Initial y_tilde* (mu = 0.2, 2025): ', num2str(y_tilde_initial)]);
disp(['Final y_tilde* (mu = 0.1, 2050+): ', num2str(y_tilde_final)]);